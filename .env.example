# Copy this file to ".env" and fill in the values. NEVER commit the real .env file.

# ---- Django -----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=repopilot
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change-me
DB_HOST=localhost          # Docker Compose overrides this with "db"
DB_PORT=5432

# ---- Frontend -> backend --------------------------------------------------------
BACKEND_URL=http://localhost:8000

# ---- LLM (required for Ask / Bug investigation / Fix suggestions) ------------------
# LLM_PROVIDER: "openai_compatible" (OpenAI, Groq, Gemini's OpenAI endpoint, OpenRouter, Ollama...) or "anthropic"
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
# Use a model name your provider currently offers (check its documentation).
LLM_MODEL=
# Needed for any provider other than OpenAI / Anthropic, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=

# ---- Optional ---------------------------------------------------------------------
# Raises GitHub's rate limit for PUBLIC repositories (a token with no scopes is enough). Used only on the server.
GITHUB_TOKEN=
# Semantic search downloads an embedding model on first use. Set to false for keyword-only search.
SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MAX_FILES=1500  MAX_FILE_KB=300  MAX_REPO_SIZE_KB=100000  MAX_ARCHIVE_MB=60  MAX_EXTRACTED_MB=150  MAX_CHUNKS=8000
